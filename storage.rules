rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /profilePhotos/{uid}/profile.jpg {
      // Profile photos are part of discoverable student profiles.
      allow read: if signedIn();
      allow create, update: if owner(uid)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if owner(uid);
    }
  }
}
