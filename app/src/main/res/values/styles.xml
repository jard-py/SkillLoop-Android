<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SkillLoopFormField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_search</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/skillloop_black</item>
        <item name="android:textColorHint">@color/skillloop_grey</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="SkillLoopFormFieldMulti" parent="SkillLoopFormField">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:gravity">top|start</item>
    </style>
</resources>
