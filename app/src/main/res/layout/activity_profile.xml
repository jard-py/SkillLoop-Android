<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/skillloop_orange">

    <ScrollView
        android:id="@+id/profile_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingBottom="92dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero image placeholder -->
            <FrameLayout
                android:id="@+id/profile_hero"
                android:layout_width="match_parent"
                android:layout_height="380dp"
                android:background="#252525">

                <ImageView
                    android:id="@+id/profile_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Student profile photo"
                    android:scaleType="centerCrop"
                    android:background="#252525" />

                <!-- Dark overlay for readable text -->
                <View
                    android:id="@+id/profile_photo_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#66000000" />

                <TextView
                    android:id="@+id/profile_initials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/skillloop_display"
                    android:gravity="center"
                    android:text="AM"
                    android:textColor="#66FFFFFF"
                    android:textSize="150sp" />

                <ImageButton
                    android:id="@+id/profile_back"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_manifesto_button"
                    android:contentDescription="Go back"
                    android:src="@android:drawable/ic_media_previous"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    android:tint="@color/skillloop_black" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/profile_course"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:text="COMPUTER ENGINEERING · YEAR 3"
                        android:textColor="@color/skillloop_white"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/profile_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/skillloop_display"
                        android:letterSpacing="0.01"
                        android:text="AARAV MEHTA."
                        android:textColor="@color/skillloop_white"
                        android:textSize="52sp" />

                    <TextView
                        android:id="@+id/profile_bio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Building things. Learning constantly."
                        android:textColor="@color/skillloop_white"
                        android:textSize="14sp" />

                </LinearLayout>
            </FrameLayout>

            <!-- Profile details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="28dp"
                android:paddingBottom="30dp"
                android:background="@color/skillloop_cream">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/skillloop_display"
                    android:text="CAN TEACH."
                    android:textColor="@color/skillloop_black"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/profile_teaches"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:text="Python · Machine Learning · Excel"
                    android:textColor="@color/skillloop_black"
                    android:textSize="16sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="22dp"
                    android:background="#D9D4CB" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/skillloop_display"
                    android:text="WANTS TO LEARN."
                    android:textColor="@color/skillloop_black"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/profile_wants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:text="UI/UX · Motion Design"
                    android:textColor="@color/skillloop_black"
                    android:textSize="16sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="22dp"
                    android:background="#D9D4CB" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/skillloop_display"
                    android:text="CURRENTLY BUILDING."
                    android:textColor="@color/skillloop_black"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/profile_project"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="A campus discovery app"
                    android:textColor="@color/skillloop_black"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/profile_project_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:text="Exploring how technology can bring students together."
                    android:textColor="@color/skillloop_grey"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="22dp"
                    android:background="#D9D4CB" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/skillloop_display"
                    android:text="INTERESTED IN."
                    android:textColor="@color/skillloop_black"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/profile_interests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:text="Startups · Design · New technology"
                    android:textColor="@color/skillloop_black"
                    android:textSize="16sp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Persistent bottom action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/skillloop_orange"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/connect_button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_manifesto_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="I'd like to connect  ↗"
            android:textColor="@color/skillloop_black"
            android:textSize="15sp" />

    </LinearLayout>

</FrameLayout>
