<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/skillloop_orange">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="12dp"
        android:paddingBottom="18dp">

        <!-- Brand header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:contentDescription="SkillLoop knot icon"
                android:scaleType="fitCenter"
                android:src="@drawable/skillloop_app_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/big_shoulders_extrabold"
                android:letterSpacing="0.015"
                android:text="SKILL LOOP"
                android:textColor="@color/skillloop_black"
                android:textSize="34sp"
                android:includeFontPadding="false" />

        </LinearLayout>

        <!-- Editorial statement -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif"
                android:fontWeight="700"
                android:letterSpacing="0.09"
                android:text="A THOUGHT FOR YOU"
                android:textColor="@color/skillloop_black"
                android:textSize="13sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/manifesto_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/big_shoulders_extrabold"
                android:letterSpacing="0"
                android:lineSpacingMultiplier="0.86"
                android:includeFontPadding="false"
                android:text="YOU DON'T&#10;HAVE TO"
                android:textColor="@color/skillloop_white"
                android:textSize="62sp" />

            <TextView
                android:id="@+id/manifesto_black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/big_shoulders_extrabold"
                android:letterSpacing="0"
                android:lineSpacingMultiplier="0.86"
                android:includeFontPadding="false"
                android:text="KNOW IT ALL.&#10;JUST KEEP&#10;LEARNING."
                android:textColor="@color/skillloop_black"
                android:textSize="62sp" />

            <TextView
                android:id="@+id/manifesto_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif"
                android:fontWeight="500"
                android:lineSpacingExtra="3dp"
                android:text="Someone on your campus knows what you want to learn."
                android:textColor="@color/skillloop_black"
                android:textSize="17sp" />

        </LinearLayout>

        <!-- User details and action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bebas_neue"
                    android:text="YOUR CAMPUS"
                    android:textColor="@color/skillloop_black"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/user_role"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Your next chapter starts here"
                    android:textColor="@color/skillloop_black"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/continue_button"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:background="@drawable/bg_manifesto_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif"
                android:fontWeight="600"
                android:gravity="center"
                android:minWidth="172dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="CREATE ACCOUNT  ↗"
                android:textColor="@color/skillloop_black"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
