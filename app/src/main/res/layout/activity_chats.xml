<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chats_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/skillloop_orange">

    <!-- CONVERSATION LIST -->
    <LinearLayout
        android:id="@+id/chat_list_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="80dp"
        android:clipToPadding="false">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/chat_mode_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:text="SKILLLOOP / MESSAGES"
                    android:textColor="@color/skillloop_black"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/big_shoulders_extrabold"
                    android:lineSpacingMultiplier="0.84"
                    android:text="CHATS\nEXCHANGES."
                    android:textColor="@color/skillloop_black"
                    android:textSize="43sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:text="Active skill exchanges and new conversations."
                    android:textColor="@color/skillloop_black"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:fontFamily="@font/big_shoulders_extrabold"
                    android:text="ACTIVE EXCHANGES"
                    android:textColor="@color/skillloop_black"
                    android:textSize="27sp" />

                <LinearLayout
                    android:id="@+id/conversation_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/chats_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="32dp"
                    android:paddingBottom="32dp"
                    android:fontFamily="@font/big_shoulders_extrabold"
                    android:text="NO CONVERSATIONS YET.\nYOUR NEXT CONNECTION IS OUT THERE."
                    android:textColor="@color/skillloop_black"
                    android:textSize="24sp"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>


    </LinearLayout>

    <!-- INDIVIDUAL CHAT SCREEN -->
    <LinearLayout
        android:id="@+id/chat_detail_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/skillloop_cream"
        android:orientation="vertical"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/skillloop_orange"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/chat_back"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/skillloop_black"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/chat_person_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/big_shoulders_extrabold"
                    android:text="MIRA SHAH."
                    android:textColor="@color/skillloop_black"
                    android:textSize="25sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SKILL EXCHANGE"
                    android:textColor="@color/skillloop_black"
                    android:textSize="9sp"
                    android:letterSpacing="0.1" />

            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/messages_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/messages_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/skillloop_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <EditText
                android:id="@+id/message_input"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search"
                android:hint="Write a message..."
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/skillloop_black"
                android:textColorHint="@color/skillloop_grey"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/send_message"
                android:layout_width="58dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_filter_selected"
                android:gravity="center"
                android:text="SEND ↗"
                android:textColor="@color/skillloop_white"
                android:textSize="11sp" />

        </LinearLayout>
    </LinearLayout>



    <!-- Shared four-destination floating island; stays visible on list and chat detail. -->
    <FrameLayout
        android:id="@+id/nav_island"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"
        android:padding="7dp"
        android:background="@drawable/bg_discover_nav_island"
        android:elevation="8dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:id="@+id/nav_active_pill"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@drawable/bg_discover_nav_active" />

        <LinearLayout
            android:id="@+id/nav_items_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/nav_discover"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="13dp"
                android:src="@drawable/ic_house"
                android:tint="#171717"
                android:scaleType="fitCenter"
                android:contentDescription="Discover"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/nav_connect"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="13dp"
                android:src="@drawable/ic_users_round"
                android:tint="#171717"
                android:scaleType="fitCenter"
                android:contentDescription="Connect"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/nav_chats"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="13dp"
                android:src="@drawable/ic_message_circle"
                android:tint="#171717"
                android:scaleType="fitCenter"
                android:contentDescription="Chats"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/nav_profile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="13dp"
                android:src="@drawable/ic_user_circle"
                android:tint="#171717"
                android:scaleType="fitCenter"
                android:contentDescription="Your profile"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
