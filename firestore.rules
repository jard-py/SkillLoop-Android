rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function profilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }
    function requestPath(requestId) {
      return /databases/$(database)/documents/connectionRequests/$(requestId);
    }
    function conversationPath(conversationId) {
      return /databases/$(database)/documents/conversations/$(conversationId);
    }
    function stableRequestId(sender, recipient) { return 'r_' + sender + '__' + recipient; }
    function stableConversationId(a, b) {
      return a < b ? 'c_' + a + '__' + b : 'c_' + b + '__' + a;
    }
    function isParticipant(conversationId) {
      return signedIn()
        && exists(conversationPath(conversationId))
        && get(conversationPath(conversationId)).data.participantIds is list
        && get(conversationPath(conversationId)).data.participantIds.size() == 2
        && get(conversationPath(conversationId)).data.participantIds.hasAny([request.auth.uid]);
    }
    function acceptedConversationAfter(conversationId) {
      let conversation = getAfter(conversationPath(conversationId)).data;
      let acceptedRequest = getAfter(requestPath(conversation.acceptedRequestId)).data;
      return signedIn()
        && conversation.participantIds is list
        && conversation.participantIds.size() == 2
        && conversation.participantIds.hasAny([request.auth.uid])
        && acceptedRequest.status == 'accepted'
        && acceptedRequest.conversationId == conversationId;
    }

    match /profiles/{uid} {
      // Only the discoverable profile projection is stored here; account email/password are not.
      allow get: if signedIn()
        && (!exists(profilePath(uid))
          || resource.data.profileComplete == true
          || request.auth.uid == uid);
      allow list: if signedIn()
        && (resource.data.profileComplete == true || request.auth.uid == uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'course', 'year', 'domain', 'bio',
          'skillsToTeach', 'skillsToLearn', 'currentProject', 'interests',
          'photoUrl', 'profileComplete', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.updatedAt == request.time
        && ((!exists(profilePath(uid)) && request.resource.data.createdAt == request.time)
          || (exists(profilePath(uid)) && request.resource.data.createdAt == resource.data.createdAt))
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.course is string
        && request.resource.data.course.size() <= 120
        && request.resource.data.year is string
        && request.resource.data.year.size() <= 32
        && request.resource.data.domain is string
        && request.resource.data.domain.size() <= 60
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 500
        && request.resource.data.skillsToTeach is string
        && request.resource.data.skillsToTeach.size() <= 400
        && request.resource.data.skillsToLearn is string
        && request.resource.data.skillsToLearn.size() <= 400
        && request.resource.data.currentProject is string
        && request.resource.data.currentProject.size() <= 200
        && request.resource.data.interests is string
        && request.resource.data.interests.size() <= 300
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 2048
        && request.resource.data.profileComplete is bool
        && (!request.resource.data.profileComplete
          || (request.resource.data.displayName.size() > 0
            && request.resource.data.course.size() > 0
            && request.resource.data.year.size() > 0
            && request.resource.data.domain.size() > 0
            && request.resource.data.skillsToTeach.size() > 0
            && request.resource.data.skillsToLearn.size() > 0));
      allow delete: if false;
    }

    match /connectionRequests/{requestId} {
      allow get: if signedIn()
        && (!exists(requestPath(requestId))
          || resource.data.senderId == request.auth.uid
          || resource.data.recipientId == request.auth.uid);
      allow list: if signedIn()
        && (resource.data.senderId == request.auth.uid
            || resource.data.recipientId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'senderId', 'recipientId', 'introductionMessage', 'conversationId',
          'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && requestId == stableRequestId(request.resource.data.senderId, request.resource.data.recipientId)
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.introductionMessage is string
        && request.resource.data.introductionMessage.size() > 0
        && request.resource.data.introductionMessage.size() <= 300
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.conversationId is string
        && request.resource.data.conversationId == stableConversationId(request.resource.data.senderId, request.resource.data.recipientId)
        && exists(profilePath(request.auth.uid))
        && get(profilePath(request.auth.uid)).data.profileComplete == true
        && exists(profilePath(request.resource.data.recipientId))
        && get(profilePath(request.resource.data.recipientId)).data.profileComplete == true
        && !exists(conversationPath(request.resource.data.conversationId));

      allow update: if signedIn()
        && request.resource.data.keys().hasOnly([
          'senderId', 'recipientId', 'introductionMessage', 'conversationId',
          'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.conversationId == resource.data.conversationId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          // Sender can cancel their own pending request.
          (resource.data.senderId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.introductionMessage == resource.data.introductionMessage
            && request.resource.data.status == 'cancelled')
          ||
          // Recipient can decline a request without creating a conversation.
          (resource.data.recipientId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.introductionMessage == resource.data.introductionMessage
            && request.resource.data.status == 'declined'
            && !exists(conversationPath(resource.data.conversationId)))
          ||
          // Recipient can accept atomically with creation of the matching conversation.
          (resource.data.recipientId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.introductionMessage == resource.data.introductionMessage
            && request.resource.data.status == 'accepted'
            && getAfter(conversationPath(resource.data.conversationId)).data.acceptedRequestId == requestId
            && getAfter(conversationPath(resource.data.conversationId)).data.participantIds.hasAll([resource.data.senderId, resource.data.recipientId])
            && getAfter(conversationPath(resource.data.conversationId)).data.participantIds.size() == 2)
          ||
          // If the other direction was already accepted, the reciprocal pending request is closed.
          (resource.data.recipientId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.introductionMessage == resource.data.introductionMessage
            && request.resource.data.status == 'cancelled'
            && exists(conversationPath(resource.data.conversationId)))
          ||
          // Re-open a previously declined/cancelled request in the same direction. Its stable ID
          // prevents duplicate pending requests from repeated taps.
          (resource.data.senderId == request.auth.uid
            && (resource.data.status == 'declined' || resource.data.status == 'cancelled')
            && request.resource.data.status == 'pending'
            && request.resource.data.introductionMessage is string
            && request.resource.data.introductionMessage.size() > 0
            && request.resource.data.introductionMessage.size() <= 300
            && !exists(conversationPath(resource.data.conversationId))
            && request.resource.data.updatedAt == request.time)
        );
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      // A conversation can only be created in the same atomic write as an accepted request;
      // its participant list and acceptedRequestId are immutable after creation.
      allow get: if signedIn()
        && (!exists(conversationPath(conversationId))
          || (resource.data.participantIds is list
            && resource.data.participantIds.size() == 2
            && resource.data.participantIds.hasAny([request.auth.uid])));
      // Queries use whereArrayContains(participantIds, currentUid). Keep the list rule
      // expressible by that query; participantIds size is enforced on conversation creation.
      allow list: if signedIn()
        && resource.data.participantIds is list
        && resource.data.participantIds.hasAny([request.auth.uid]);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'participantIds', 'acceptedRequestId', 'createdAt', 'updatedAt',
          'lastMessage', 'lastMessageSenderId', 'lastMessageAt'
        ])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds.hasAny([request.auth.uid])
        && request.resource.data.acceptedRequestId is string
        && getAfter(requestPath(request.resource.data.acceptedRequestId)).data.status == 'accepted'
        && getAfter(requestPath(request.resource.data.acceptedRequestId)).data.recipientId == request.auth.uid
        && request.resource.data.participantIds.hasAll([
          getAfter(requestPath(request.resource.data.acceptedRequestId)).data.senderId,
          getAfter(requestPath(request.resource.data.acceptedRequestId)).data.recipientId
        ])
        && conversationId == stableConversationId(
          getAfter(requestPath(request.resource.data.acceptedRequestId)).data.senderId,
          getAfter(requestPath(request.resource.data.acceptedRequestId)).data.recipientId)
        && getAfter(requestPath(request.resource.data.acceptedRequestId)).data.conversationId == conversationId
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage == getAfter(requestPath(request.resource.data.acceptedRequestId)).data.introductionMessage
        && request.resource.data.lastMessageSenderId == getAfter(requestPath(request.resource.data.acceptedRequestId)).data.senderId
        && request.resource.data.lastMessage.size() <= 300
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageAt == request.time;

      allow update: if isParticipant(conversationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageAt', 'lastMessageSenderId', 'updatedAt'
        ])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastMessageSenderId == request.auth.uid
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(conversationId);
        allow create: if request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt', 'isIntroduction'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && request.resource.data.isIntroduction is bool
          && (
            (request.resource.data.isIntroduction == true
              && messageId == 'intro_' + getAfter(conversationPath(conversationId)).data.acceptedRequestId
              && acceptedConversationAfter(conversationId)
              && request.resource.data.senderId == getAfter(requestPath(getAfter(conversationPath(conversationId)).data.acceptedRequestId)).data.senderId
              && request.resource.data.text == getAfter(requestPath(getAfter(conversationPath(conversationId)).data.acceptedRequestId)).data.introductionMessage)
            ||
            (request.resource.data.isIntroduction == false
              && isParticipant(conversationId)
              && request.resource.data.senderId == request.auth.uid)
          );
        allow update, delete: if false;
      }
    }
  }
}
